{
  "name": "@open-agent-email/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Open Agent Email REST API, webhooks and real-time inbox stream.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" } },
  "files": ["dist/src"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" }
}
