{
  "description": "Golden webhook signing vectors shared by the server, TypeScript and Python tests. Webhook-Signature signs `<t>.<body>`; X-Webhook-Signature signs `<t>.<event id>.<body>`.",
  "cases": [
    {
      "name": "single secret",
      "timestamp": "1800000000",
      "event_id": "evt_0123456789abcdef",
      "event_type": "email.received",
      "secrets": [
        "whsec_golden_current"
      ],
      "body": "{\"id\":\"evt_0123456789abcdef\",\"message_id\":\"msg_abc\",\"agent_email\":\"bot@agents.local\",\"direction\":\"inbound\",\"sender\":\"a@example.com\",\"recipient\":\"bot@agents.local\",\"status\":\"delivered\",\"thread_id\":\"th_1\",\"created_at\":\"2027-01-15T08:00:00\",\"type\":\"email.received\",\"schema_version\":\"1\",\"data\":{\"message_id\":\"msg_abc\",\"agent_email\":\"bot@agents.local\",\"direction\":\"inbound\",\"sender\":\"a@example.com\",\"recipient\":\"bot@agents.local\",\"status\":\"delivered\",\"thread_id\":\"th_1\"}}",
      "expected_headers": {
